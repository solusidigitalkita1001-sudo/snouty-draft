# SNOUTY — contoh environment (SPEC §17b).
# Salin ke .env dan isi. JANGAN pernah commit .env atau menaruh nilai asli di sini.
#
# Catatan keamanan: sampai akun database terbatas dibuat (OQ-34), kredensial
# yang dipakai punya hak penuh atas SELURUH server bersama di 192.168.1.136 —
# termasuk tujuh database aplikasi lain. Perlakukan setara kredensial produksi.
# Lihat docs/DATABASE.md §3.

# App
NODE_ENV=
APP_URL=
API_URL=

# MySQL (terpusat — infrastruktur bersama, lihat docs/DATABASE.md)
DB_HOST=192.168.1.136
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_POOL_MAX=

# Redis — port baku docker-compose adalah 6380, bukan 6379 (lihat docker-compose.yml)
REDIS_URL=redis://127.0.0.1:6380

# RabbitMQ — port baku docker-compose adalah 5673, bukan 5672
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5673

# Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=
GUEST_SESSION_TTL=

# LLM
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_BALANCED=
LLM_MODEL_STRONG=

# Qdrant (hanya bila kelak diadopsi — lihat docs/PRODUCT_KNOWLEDGE.md §5)
QDRANT_URL=
QDRANT_API_KEY=

# Integrasi
N8N_WEBHOOK_SECRET=
TECH_HANDOFF_TARGET=

# Berkas
UPLOAD_MAX_MB=
STORAGE_PATH=

# Harga (hanya bila masuk lingkup — OQ-03; default nonaktif)
PRICING_ENABLED=false
TAX_RATE_PERCENT=
