# SNOUTY — contoh environment (SPEC §17b).
# Salin ke .env dan isi. JANGAN pernah commit .env atau menaruh nilai asli di sini.
#
# Catatan keamanan: kredensial untuk server bersama di 192.168.1.136 punya hak penuh
# atas SELURUH server itu — termasuk tujuh database aplikasi lain (OQ-34). Berkas ini
# sengaja TIDAK memuatnya: pengembangan memakai database lokal, dan kredensial yang
# tidak ada di contoh adalah kredensial yang tidak bisa tersalin tanpa sengaja.
# Lihat docs/DATABASE.md §3 dan §4a.

# App
NODE_ENV=
APP_URL=
API_URL=

# MySQL — PENGEMBANGAN MEMAKAI DATABASE LOKAL (docs/DATABASE.md §4a).
# `docker compose up -d mysql` menyediakannya; nilai di bawah cocok dengan compose.
#
# Server bersama di 192.168.1.136 tetap tujuan akhir, tetapi menaruh alamatnya di
# sini sebagai nilai contoh berarti setiap `cp .env.example .env` mengarahkan mesin
# pengembang ke infrastruktur bersama — dan itu kesalahan yang hanya perlu terjadi
# sekali. Prosedur pindah ke sana ada di docs/DATABASE.md §4.
DB_HOST=127.0.0.1
DB_PORT=3316
DB_DATABASE=snouty
DB_USERNAME=snouty
DB_PASSWORD=snouty
DB_POOL_MAX=10

# Redis — port baku docker-compose adalah 6380, bukan 6379 (lihat docker-compose.yml)
REDIS_URL=redis://127.0.0.1:6380

# RabbitMQ — port baku docker-compose adalah 5673, bukan 5672
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5673

# Auth — WAJIB diisi; proses menolak start tanpa kedua rahasia ini.
# Bangkitkan dengan:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=2592000
GUEST_SESSION_TTL=86400
# Token layanan apps/worker untuk /internal/reports/* (OQ-49): nilai yang sama di env API dan
# worker, ≥ 32 karakter (openssl rand -base64 36). Kosong → PDF laporan tidak dibuat.
WORKER_INTERNAL_TOKEN=

# Privasi — versi kebijakan yang tersimpan di setiap baris consent (OQ-12)
POLICY_VERSION=v0-draft

# LLM
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_BALANCED=
LLM_MODEL_STRONG=
# Latensi (docs/AI_BEHAVIOR.md §10): model merangkai ulang FAQ produk (baku false — teks
# deterministiknya utuh), dan batas tunggu balasan percakapan sebelum teks tetap dipakai.
LLM_FAQ_REWRITE=false
LLM_REPLY_TIMEOUT_MS=20000

# Qdrant (hanya bila kelak diadopsi — lihat docs/PRODUCT_KNOWLEDGE.md §5)
QDRANT_URL=
QDRANT_API_KEY=

# Integrasi
N8N_WEBHOOK_SECRET=
TECH_HANDOFF_TARGET=

# Berkas
UPLOAD_MAX_MB=
STORAGE_PATH=

# Harga (hanya bila masuk lingkup — OQ-03; default nonaktif)
PRICING_ENABLED=false
TAX_RATE_PERCENT=
