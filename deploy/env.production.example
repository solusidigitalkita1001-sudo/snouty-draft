# SNOUTY — environment produksi. Salin ke `.env.production` di akar repo dan isi.
# JANGAN commit berkas hasil salinannya (sudah ada di .gitignore sebagai .env.*).

# ── MySQL milik SNOUTY di server ini (service `mysql` di compose) ──
DB_ROOT_PASSWORD=                 # openssl rand -base64 24
DB_DATABASE=snouty
DB_USERNAME=snouty
DB_PASSWORD=                      # openssl rand -base64 24
DB_PORT=3316                      # port di 127.0.0.1 host, untuk migration/impor
DB_POOL_MAX=10

# ── Auth ──  openssl rand -base64 48  (minimal 32 karakter)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
POLICY_VERSION=v1
WORKER_INTERNAL_TOKEN=            # openssl rand -base64 36 — worker menolak start tanpa ini

# ── Model bahasa (opsional tetapi tanpa ini ekstraksi kebutuhan rumah tidak jalan) ──
# OpenRouter: kunci baru (yang lama sudah bocor — revoke). Atau Ollama di server:
#   OPENROUTER_BASE_URL=http://host.docker.internal:11434/v1  OPENROUTER_API_KEY=ollama
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Slug berbayar: akun OpenRouter harus berkredit. Slug `:free` sudah dihapus OpenRouter (2026-10).
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_BALANCED=openai/gpt-4.1-mini
LLM_MODEL_STRONG=openai/gpt-4.1-mini
# Pemahaman pertanyaan dari contoh (docs/AI_BEHAVIOR.md §4a). Ollama: `ollama pull bge-m3` sekali.
LLM_MODEL_EMBEDDING=bge-m3
LLM_FAQ_REWRITE=false
# ── Jawaban pengetahuan umum pipa (P30-01, keputusan pemilik 2026-10-26) ──
# Pertanyaan teknik pemipaan yang tidak tercakup fakta bersumber (thrust block, kelas kekakuan SN,
# jarak support, PVC-O, ekspansi termal) dijawab dari pengetahuan model, dipagari kode: jawabannya
# tidak boleh menyebut Pralon maupun merek lain, berbentuk prosa, dan setiap angka membawa baris
# "bukan spesifikasi Pralon". Tanpa LLM_MODEL_KNOWLEDGE jalurnya MATI dan pertanyaan seperti itu
# tetap dijawab tawaran tim teknis — persis keadaan sebelum P30-01.
#
# Model lokal 9B di CPU tidak memadai untuk jalur ini (OQ-45: 7B pernah menukar sifat PVC dan
# HDPE). Isi dengan model hosted, dan arahkan endpointnya ke penyedia itu — chat lain tetap di
# Ollama lokal, jadi KNOWLEDGE_BASE_URL dan KNOWLEDGE_API_KEY memang perlu diisi sendiri.
LLM_MODEL_KNOWLEDGE=              # mis. openai/gpt-4.1-mini — kosong = jalur mati
KNOWLEDGE_BASE_URL=               # mis. https://openrouter.ai/api/v1
KNOWLEDGE_API_KEY=                # kunci penyedia di atas (bukan kunci Ollama)
LLM_KNOWLEDGE_TIMEOUT_MS=20000    # lewat batas ini pertanyaannya jatuh ke jalur lama
LLM_REPLY_TIMEOUT_MS=10000
LLM_CALL_TIMEOUT_MS=90000

# ── Kirim kasus ke tim teknis lewat n8n (OQ-08) ──
# Tanpa ketiganya tombol "Kirim ke tim teknis" TETAP BEKERJA — kasusnya masuk antrean internal di
# /internal/handoff — tetapi tidak ada email yang terkirim: worker mencatat "pengiriman handoff
# belum dikonfigurasi" lalu menyelesaikan job. Mengisi ketiganya menyalakan pengirimannya.
#
# Yang dikirim worker ke webhook: POST JSON {to, handoffId, conversationId, subject, text},
# dengan header `x-snouty-timestamp` dan `x-snouty-signature` =
# HMAC-SHA256(N8N_WEBHOOK_SECRET, "<timestamp>.<badan mentah>") dalam hex. Alur n8n sebaiknya
# memverifikasi tanda tangan itu lebih dulu (docs/SECURITY.md §5), baru mengirim emailnya.
N8N_HANDOFF_WEBHOOK_URL=          # mis. https://n8n.pralon.co.id/webhook/snouty-handoff
N8N_WEBHOOK_SECRET=               # openssl rand -base64 36 — sama persis dengan yang di alur n8n
TECH_HANDOFF_TARGET=              # alamat email tim teknis yang menerima kasusnya

# ── Harga di laporan (OQ-03/OQ-04) ──
# Baku NONAKTIF: laporan keluar tanpa kolom harga. Menyalakannya tanpa sumber harga resmi berarti
# angka karangan di dokumen yang dibawa ke pelanggan — jangan dinyalakan sebelum OQ-04 terjawab.
PRICING_ENABLED=false

# ── Lain-lain ──
APP_URL=https://ai.pralon.co.id
TAX_RATE_PERCENT=11
SNOUTY_TAG=latest

# Salinan cadangan ke luar server (deploy.sh db-backup-offsite). Kosong = dilewati.
# BACKUP_REMOTE=user@nas.internal:/backup/snouty
# BACKUP_GPG_RECIPIENT=backup@pralon.example
BACKUP_REMOTE=
BACKUP_GPG_RECIPIENT=
