# SNOUTY — environment produksi. Salin ke `.env.production` di akar repo dan isi.
# JANGAN commit berkas hasil salinannya (sudah ada di .gitignore sebagai .env.*).

# ── MySQL milik SNOUTY di server ini (service `mysql` di compose) ──
DB_ROOT_PASSWORD=                 # openssl rand -base64 24
DB_DATABASE=snouty
DB_USERNAME=snouty
DB_PASSWORD=                      # openssl rand -base64 24
DB_PORT=3316                      # port di 127.0.0.1 host, untuk migration/impor
DB_POOL_MAX=10

# ── Auth ──  openssl rand -base64 48  (minimal 32 karakter)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
POLICY_VERSION=v1
WORKER_INTERNAL_TOKEN=            # openssl rand -base64 36 — worker menolak start tanpa ini

# ── Model bahasa (opsional tetapi tanpa ini ekstraksi kebutuhan rumah tidak jalan) ──
# OpenRouter: kunci baru (yang lama sudah bocor — revoke). Atau Ollama di server:
#   OPENROUTER_BASE_URL=http://host.docker.internal:11434/v1  OPENROUTER_API_KEY=ollama
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Slug berbayar: akun OpenRouter harus berkredit. Slug `:free` sudah dihapus OpenRouter (2026-10).
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_BALANCED=openai/gpt-4.1-mini
LLM_MODEL_STRONG=openai/gpt-4.1-mini
# Pemahaman pertanyaan dari contoh (docs/AI_BEHAVIOR.md §4a). Ollama: `ollama pull bge-m3` sekali.
LLM_MODEL_EMBEDDING=bge-m3
LLM_FAQ_REWRITE=false
LLM_REPLY_TIMEOUT_MS=10000
LLM_CALL_TIMEOUT_MS=90000

# ── Lain-lain ──
APP_URL=https://ai.pralon.co.id
TAX_RATE_PERCENT=11
SNOUTY_TAG=latest
