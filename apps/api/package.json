{
  "name": "@snouty/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -w -p tsconfig.build.json & node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:apply": "node scripts/db-apply.mjs",
    "test:migration": "node scripts/test-migration.mjs",
    "seed:sample": "node scripts/seed-sample-catalog.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@snouty/shared-types": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.5",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
