{
  // Tipe tes juga diperiksa. tsconfig.json sengaja mengecualikan `*.spec.ts`
  // supaya tidak ikut masuk `dist`; konsekuensinya tes tidak pernah di-typecheck,
  // dan vitest menjalankan TS lewat esbuild yang membuang tipe tanpa memeriksanya.
  // Berkas ini menutup celah itu tanpa mengubah keluaran build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "test"],
  "exclude": []
}
